# Bridge Configuration Example

# Listener Ports
PUBLIC_PORT=3000
LOCAL_PORT=3001

# Public URL (Tunnel or Custom Domain)
PUBLIC_BASE_URL=http://localhost:3000

# Authentication & Security
BRIDGE_API_KEY=test-bridge-api-key-secret-123
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars
ADMIN_PASSWORD=admin-secure-password
AGENT_ANTIGRAVITY_TOKEN=your-rotated-agent-token-here

# Rate Limiting & Limits
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_SIZE_BYTES=65536

# Database
DB_PATH=./bridge.sqlite

# Optional Model Participants
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
